# Copie para server/.env e preencha (nunca commite o .env)

PORT=3001
NODE_ENV=development

# Domínios do front separados por vírgula (não use * em produção)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001

# Postgres Aiven — connection string completa
AIVEN_DATABASE_URL=

# Opcional: caminho do CA do Aiven (recomendado em produção)
# AIVEN_CA_PATH=./certs/ca.pem

# Só true em desenvolvimento local se o TLS for inválido. NUNCA true em produção.
DATABASE_SSL_INSECURE=false

# Chave AES-256-GCM para cifrar two_fa_secret
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FA_ENCRYPTION_KEY=

# Nome no app autenticador
TOTP_ISSUER=PowerApps Sistemas

LOGIN_TEMP_TTL_MS=300000
TWO_FA_MAX_ATTEMPTS=5
TWO_FA_LOCK_MS=900000
AUTH_RATE_LIMIT_MAX=30
TWO_FA_VERIFY_RATE_MAX=40
